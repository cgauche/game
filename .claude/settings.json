{
  "claudeMdExcludes": ["**/Foundry/CLAUDE.md"],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/scripts/hooks/new-src-file-guard.mjs",
            "timeout": 10,
            "statusMessage": "Garde anti-réinvention (nouveau fichier src/)"
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/scripts/hooks/data-edit-guard.mjs",
            "timeout": 10,
            "statusMessage": "Grounding donnée (src/data — check-first #148)"
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/scripts/hooks/enterine-guard.mjs",
            "timeout": 10,
            "statusMessage": "Tag [entériné] = validation utilisateur"
          }
        ]
      },
      {
        "matcher": "DESACTIVE-TEMPORAIREMENT-2026-07-14-absence-user__Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/scripts/hooks/exception-add-guard.mjs",
            "timeout": 10,
            "statusMessage": "Ajout d'exception de garde = autorisation utilisateur"
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell|mcp__lean-ctx__ctx_shell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/scripts/hooks/git-destructive-guard.mjs",
            "timeout": 10,
            "statusMessage": "Garde git destructif (arbre partagé)"
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell|mcp__lean-ctx__ctx_shell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/scripts/hooks/solde-ticket-guard.mjs",
            "timeout": 10,
            "statusMessage": "Fermeture de ticket au commit = solde écrit obligatoire"
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell|mcp__lean-ctx__ctx_shell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/scripts/hooks/issue-label-guard.mjs",
            "timeout": 10,
            "statusMessage": "Ticket sans label refusé (index du backlog)"
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/scripts/hooks/agent-dispatch-design-reminder.mjs",
            "timeout": 10,
            "statusMessage": "Rappel altitude de design (dispatch d'agent)"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/scripts/hooks/poison-postcheck.mjs",
            "timeout": 10,
            "statusMessage": "Garde anti-poison au stylo (tombstone/excuse/label)"
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/scripts/hooks/agent-return-judge-reminder.mjs",
            "timeout": 10,
            "statusMessage": "Rappel juge adversarial (retour d'agent)"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/scripts/hooks/inject-project-credo.mjs claude",
            "timeout": 10,
            "statusMessage": "Injection du credo de travail"
          }
        ]
      }
    ]
  }
}
