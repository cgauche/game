#!/bin/sh
# scripts/git-hooks/post-commit
#
# Ferme AUTOMATIQUEMENT les issues GitHub citées par le message du commit qui
# vient d'être créé (issue #137 — fermeture MÉCANIQUE, pas une règle
# d'obéissance : une issue ouverte décrivant un bug déjà corrigé est du poison).
#
# Motifs reconnus, insensibles à la casse, plusieurs occurrences par message :
#   fixes #N | closes #N | corrige #N | ferme #N
#
# Contrat : ce hook ne doit JAMAIS faire échouer le commit qui vient d'avoir
# lieu. Toute erreur (hors-ligne, `gh` absent, issue déjà fermée, dépôt sans
# token...) reste un warning silencieux sur stderr ; sortie TOUJOURS 0.

set -u

REPO="cgauche/game"

warn() {
  echo "post-commit: $1" >&2
}

MSG="$(git log -1 --format=%B 2>/dev/null)"
if [ -z "$MSG" ]; then
  exit 0
fi

if ! command -v gh >/dev/null 2>&1; then
  warn "gh introuvable — fermeture auto d'issue ignorée"
  exit 0
fi

# Extrait tous les numéros d'issue suivant fixes/closes/corrige/ferme, dédupliqués.
ISSUES="$(printf '%s\n' "$MSG" | grep -Eio '(fixes|closes|corrige|ferme)[[:space:]]+#[0-9]+' | grep -Eo '[0-9]+' | sort -un)"

if [ -z "$ISSUES" ]; then
  exit 0
fi

HASH="$(git rev-parse --short HEAD 2>/dev/null)"
[ -n "$HASH" ] || HASH="?"

for N in $ISSUES; do
  if gh issue close "$N" --repo "$REPO" --comment "Fermé automatiquement par le commit $HASH" >/dev/null 2>/dev/null; then
    :
  else
    warn "impossible de fermer #$N (hors-ligne, déjà fermée, ou gh en erreur) — ignoré"
  fi
done

exit 0
