#!/bin/sh
# scripts/git-hooks/pre-commit — porte au COMMIT : gardes anti-poison diff-scopées.
# Toute la logique vit dans pre-commit.mjs (mécanique partagée scripts/guards/lib/).
# Contrat inverse de post-commit : ce hook DOIT pouvoir refuser le commit (exit != 0).
exec node "$(dirname "$0")/pre-commit.mjs" "$@"
