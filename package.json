{
  "name": "warhammer-v4-rpg",
  "version": "0.1.0",
  "private": true,
  "description": "RPG tactique au tour par tour Warhammer Fantasy v4 (web, type Neverwinter Nights) — en français",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "postinstall": "git config core.hooksPath scripts/git-hooks",
    "gen": "node scripts/gen-registry.mjs",
    "dev": "vite",
    "build": "npm run gen && tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:hooks": "node --test scripts/hooks/exception-add-guard.test.mjs scripts/hooks/solde-ticket-guard.test.mjs",
    "typecheck": "tsc --noEmit --incremental --tsBuildInfoFile node_modules/.cache/typecheck.tsbuildinfo",
    "docs:check": "node scripts/docs/check-doc-refs.mjs && node scripts/docs/build-systemes.mjs --check",
    "docs:systemes": "node scripts/docs/build-systemes.mjs",
    "issues:export": "node scripts/ops/export-issues.mjs",
    "deps:unused": "knip --dependencies",
    "deps:report": "node scripts/ops/deps-report.mjs",
    "raw:coverage": "node scripts/raw/coverage.mjs",
    "raw:reconcile": "node scripts/raw/reconcile.mjs",
    "raw:catalogs": "node scripts/raw/build-catalogs.mjs",
    "lint": "eslint . --max-warnings 0",
    "relay:dev": "npm --prefix server run dev",
    "relay:deploy": "npm --prefix server run deploy",
    "galleries": "node scripts/gen-galleries.mjs",
    "qc:sheets": "tsx scripts/_qc-sheets.mts",
    "qc:env": "tsx scripts/qc/render-env.mts",
    "qc:occlusion": "tsx scripts/qc/render-occlusion.mts"
  },
  "dependencies": {
    "@fontsource/grenze-gotisch": "^5.2.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.4.3",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^25.9.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^10.4.1",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "knip": "^6.26.0",
    "tsx": "^4.19.2",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.60.1",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
